  "components": {
    "schemas": {
      "AddSeriesRequest": {
        "required": [
          "cast",
          "country",
          "description",
          "director",
          "duration",
          "genres",
          "rating",
          "seasons",
          "title",
          "year"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 100,
            "minLength": 2,
            "pattern": "^[a-zA-Zа-яА-Я0-9\\s\\-\\.\\,]+$",
            "type": "string"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "maximum": 2030,
            "minimum": 1950,
            "type": "integer",
            "format": "int32"
          },
          "seasons": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "duration": {
            "maximum": 180,
            "minimum": 5,
            "type": "integer",
            "format": "int32"
          },
          "director": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          },
          "country": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "poster": {
            "pattern": "^[\\w\\-\\.]+\\.(jpg|jpeg|png|gif|webp)$",
            "type": "string",
            "nullable": true
          },
          "description": {
            "maxLength": 2000,
            "minLength": 50,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
